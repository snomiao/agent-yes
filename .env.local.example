# Codex on DeepSeek. Prefer `ay codex-ds` (OpenRouter) — it needs only
# OPENROUTER_API_KEY and no proxy. The keys below are for the direct-to-DeepSeek
# adapter (`ay ds`, scripts/deepseek-codex.ts); see docs/deepseek-codex.md.
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro
