{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@agent-yes/liagent": ["./src/browser.ts"],
      "@agent-yes/liagent/*": ["./src/*.ts"]
    }
  },
  "include": ["src", "test", "scripts", "examples", "demo"]
}
