# agent-yes, as released: one published npm version plus that version's Rust
# binaries, ready to `ay serve --webrtc` with no first-start downloads.
#
#   docker build -f docker/Dockerfile.release --build-arg AY_VERSION=1.301.0 .
#   docker run --rm -it -v ay-home:/home/agent snomiao/agent-yes
#
# Unlike docker/Dockerfile (built from the checked-out source on every commit),
# this installs a version that is already on npm and GitHub Releases, so the
# build context is not used and the image matches what `bun add -g agent-yes`
# gives a user, plus:
#   - ayrs (the Rust serve daemon) and the Rust CLI from the GitHub release of
#     the same version, checked against the asset digests GitHub publishes.
#     Without them `ay serve` logs "ayrs binary not found" and falls back to
#     the TypeScript server.
#   - node-datachannel's prebuilt addon. `bun add -g` skips its install script,
#     so ay would otherwise fetch it on first start (see ts/share.ts).
#   - Claude Code (native installer), run as the non-root user `agent`.
# No credentials are baked in: log in inside the container and keep
# /home/agent on a volume.
FROM ubuntu:24.04

ARG AY_VERSION
ARG BUN_VERSION=1.3.14
ARG DEBIAN_FRONTEND=noninteractive

RUN test -n "$AY_VERSION" || { echo "build with --build-arg AY_VERSION=x.y.z" >&2; exit 1; }

RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git jq tini procps less \
 && rm -rf /var/lib/apt/lists/*

# Bun from its npm tarball, pinned by the registry's sha512 integrity.
RUN case "$(uname -m)" in \
      aarch64) pkg=bun-linux-aarch64; sha=5f94ac3d91ecfa260ef11fde7c8711b5cee04f64360e03df9620b1124c7871706e9b0930d1cfc4b0730dc07dc4806a420da67b21854f869086ff104e40713067 ;; \
      x86_64) pkg=bun-linux-x64-baseline; sha=abff0474e0b4c9413c14f7a8395abcfcfc3923dfed25a62651f3bfb83500444c7c2149ce247d5127903706316aadef29bc9a22640f40a2f3c9ab916734d8d2c4 ;; \
      *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; \
    esac \
 && curl -fsSL "https://registry.npmjs.org/@oven/$pkg/-/$pkg-$BUN_VERSION.tgz" -o /tmp/bun.tgz \
 && echo "$sha  /tmp/bun.tgz" | sha512sum -c - \
 && tar -xzf /tmp/bun.tgz -C /usr/local/bin --strip-components=2 package/bin/bun \
 && chmod 755 /usr/local/bin/bun && rm /tmp/bun.tgz \
 && bun --version

RUN useradd -m -s /bin/bash agent
USER agent
ENV HOME=/home/agent BUN_INSTALL=/home/agent/.bun LANG=C.UTF-8 TERM=xterm-256color
ENV PATH=/home/agent/.local/bin:/home/agent/.bun/bin:$PATH
WORKDIR /home/agent

RUN bun add --global "agent-yes@$AY_VERSION"

# The release's Rust binaries go into the package's own bin/, the first place
# ay looks (getBinDir in ts/rustBinary.ts), so they always match the package.
RUN case "$(uname -m)" in aarch64) arch=arm64 ;; x86_64) arch=x64 ;; esac \
 && asset="agent-yes-linux-$arch-musl.tar.gz" \
 && digest=$(curl -fsSL "https://api.github.com/repos/snomiao/agent-yes/releases/tags/v$AY_VERSION" \
      | jq -r --arg n "$asset" '.assets[] | select(.name == $n) | .digest') \
 && case "$digest" in sha256:*) ;; *) echo "no digest for $asset in v$AY_VERSION" >&2; exit 1 ;; esac \
 && curl -fsSL "https://github.com/snomiao/agent-yes/releases/download/v$AY_VERSION/$asset" -o /tmp/ay.tgz \
 && echo "${digest#sha256:}  /tmp/ay.tgz" | sha256sum -c - \
 && pkg="$BUN_INSTALL/install/global/node_modules/agent-yes" \
 && mkdir -p "$pkg/bin" && tar -xzf /tmp/ay.tgz -C "$pkg/bin" && rm /tmp/ay.tgz \
 && chmod 755 "$pkg/bin/"* && "$pkg/bin/ayrs" --version

# The prebuilt node-datachannel addon, fetched the way its install script would.
RUN nd="$BUN_INSTALL/install/global/node_modules/node-datachannel" \
 && cd "$nd" && bun "$(bun -e "console.log(require.resolve('prebuild-install/bin.js', { paths: ['$nd'] }))")" -r napi \
 && test -f "$nd/build/Release/node_datachannel.node"

RUN curl -fsSL https://claude.ai/install.sh | bash \
 && claude --version && ay --version

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["ay", "serve", "--webrtc"]
